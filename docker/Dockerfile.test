# Pull step CLI binary from smallstep image
FROM smallstep/step-cli:latest AS step-cli

FROM debian:bookworm-slim

# Build + test dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    cmake \
    pkg-config \
    libssl-dev \
    libseccomp-dev \
    openssl \
    softhsm2 \
    opensc \
    jq \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Install step CLI
COPY --from=step-cli /usr/local/bin/step /usr/local/bin/step

WORKDIR /build/pkcs11-proxy
COPY . .

# Build pkcs11-proxy
RUN cmake . && make

# Build test helpers (linked with policy module + cJSON)
RUN gcc -o tests/test-tls-server tests/test-tls-server.c \
        src/tls/gck-rpc-tls-policy.c ext/cjson/cJSON.c \
        -Iinclude -I. -Iext -Ipkcs11 \
        -lssl -lcrypto -Wall -Wextra \
    && gcc -o tests/test-tls-client tests/test-tls-client.c \
        src/tls/gck-rpc-tls-policy.c ext/cjson/cJSON.c \
        -Iinclude -I. -Iext -Ipkcs11 \
        -lssl -lcrypto -Wall -Wextra \
    && gcc -o tests/test-pkcs11-tool tests/test-pkcs11-tool.c \
        -Iinclude -I. -Ipkcs11 \
        -ldl -Wall -Wextra

# Build SECCOMP-enabled daemon for seccomp tests
RUN gcc -o pkcs11-daemon-seccomp \
        src/daemon/gck-rpc-daemon-standalone.c src/common/gck-rpc-dispatch.c \
        src/common/gck-rpc-message.c src/common/gck-rpc-util.c \
        src/common/egg-buffer.c src/tls/gck-rpc-tls.c \
        src/tls/gck-rpc-tls-policy.c src/seccomp/syscall-reporter.c \
        ext/cjson/cJSON.c \
        -D_GNU_SOURCE -DSECCOMP -DDEBUG_SECCOMP \
        -Iinclude -I. -Iext -Ipkcs11 \
        -ldl -lpthread -lssl -lcrypto -lseccomp -Wall -Wextra

# Generate test PKI using step CLI
RUN chmod +x tests/generate-test-pki.sh && tests/generate-test-pki.sh

# Prepare SoftHSM for integration tests — PINs read from files, never on CLI
RUN mkdir -p /var/lib/softhsm/tokens /etc/softhsm \
    && printf '1234' > /etc/softhsm/pin \
    && printf '5678' > /etc/softhsm/so-pin \
    && chmod 600 /etc/softhsm/pin /etc/softhsm/so-pin \
    && softhsm2-util --init-token --slot 0 --label cosign \
       --pin "$(cat /etc/softhsm/pin)" --so-pin "$(cat /etc/softhsm/so-pin)"

# Make scripts executable
RUN chmod +x tests/run-all.sh \
    && chmod +x docker/integration/generate-pki.sh \
    && chmod +x docker/integration/entrypoint-server.sh \
    && chmod +x docker/integration/entrypoint-client.sh \
    && chmod +x docker/integration/run.sh

ENTRYPOINT ["tests/run-all.sh"]
